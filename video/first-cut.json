    { "move": "takes", "from": 148, "to": 152, "every": 2, "length": 1, "start": 0 },
    { "at": 152, "do": [
      { "transition": "lum-key" }, { "buses": [2, 3] }, { "colourCorrect": { "bus": "B", "mode": "chroma-plus-joystick" } }
    ], "patch": { "2": "crowd" } },
    { "move": "set", "lane": "lever", "at": 152, "value": 1 },
    { "move": "set", "lane": "chromaB", "at": 152, "value": 1 },
    { "move": "ramp", "lane": "hueB", "from": 152, "to": 156, "values": [0, 1] },
