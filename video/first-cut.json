    { "move": "ramp", "lane": "fade", "from": 163, "to": 164.5, "values": [0, 1], "curve": "ease" },
    { "move": "ramp", "lane": "dskHigh", "from": 165, "to": 166.5, "values": [0.42, 0], "curve": "ease" }
