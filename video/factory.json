      { "buses": [1, 2] }, { "transition": "mix" }, { "effect": { "bus": "A" } },
      { "command": { "type": "SET_GRADATION", "on": false } }, { "matte": "yellow" },
      { "dsk": { "fill": "matte", "reverse": true, "edge": "drop-shadow" } }
    ], "play": { "dance": { "from": 30 }, "ride": { "from": 4 }, "shapes": { "from": 0 } } },
    { "move": "set", "lane": "dskHigh", "at": 102, "value": 0.3 },
    { "move": "set", "lane": "chromaA", "at": 102, "value": 0.9 },
    { "move": "set", "lane": "chromaB", "at": 102, "value": 0.9 },
    { "move": "ramp", "lane": "hueA", "from": 102, "to": 110, "values": [0, 3] },
    { "move": "ramp", "lane": "hueB", "from": 102, "to": 110, "values": [0.5, -2.5] },
    { "move": "cuts", "from": 102, "to": 110, "every": 1, "start": 0 },
    { "at": 103, "do": [{ "fade": { "target": "matte", "video": true, "dsk": false } }] },
    { "move": "steps", "lane": "fade", "from": 103, "every": 0.5,
      "values": [0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5,
                 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5, 0, 0.5] },
    { "move": "set", "lane": "fade", "at": 110, "value": 0 },
    { "at": 104, "do": [{ "matte": "cyan" }] },
    { "at": 106, "do": [{ "matte": "magenta" }, { "avSynchro": ["nega"] }, { "effect": { "bus": "A", "multi": 4 } }] },
    { "at": 108, "do": [{ "matte": "green" }] },

    { "section": "Drop IV · tunnel key, strobing", "at": 110 },
    { "at": 110, "do": [
      { "transition": "lum-key" }, { "buses": [1, 4] }, { "effect": { "bus": "A", "paint": true, "strobe": true } },
      { "command": { "type": "SET_PAINT_LEVEL", "level": 0.75 } }, { "dsk": false }, { "avSynchro": [] }
    ], "play": { "tunnel": { "from": 0, "rate": 1.5 } } },
    { "move": "set", "lane": "lever", "at": 110, "value": 1 },
    { "move": "set", "lane": "strobe", "at": 110, "value": 0.2 },
    { "move": "set", "lane": "chromaA", "at": 110, "value": 0.85 },
    { "move": "set", "lane": "chromaB", "at": 110, "value": 1 },
    { "move": "pump", "from": 110, "to": 116, "low": 0.2, "high": 0.7 },
    { "move": "ramp", "lane": "hueA", "from": 110, "to": 116, "values": [0, 1.5] },
    { "move": "ramp", "lane": "hueB", "from": 110, "to": 116, "values": [0.5, -1] },
    { "move": "rotate", "input": 1, "from": 110, "to": 116, "every": 2, "clips": ["ride", "dance"] },

    { "section": "Hold · frozen into colour", "at": 116 },
    { "at": 116, "note": "The picture freezes and sinks into a gradient matte instead of black.", "do": [
      { "transition": "mix" }, { "effect": { "bus": "A", "still": true } },
      { "matte": "magenta" }, { "command": { "type": "SET_GRADATION", "on": true } },
      { "fade": { "target": "matte", "video": true, "dsk": true } }
    ] },
    { "move": "set", "lane": "lever", "at": 116, "value": 0 },
    { "move": "ramp", "lane": "hueA", "from": 116, "to": 118, "values": [1.5, 2.5] },
    { "move": "ramp", "lane": "fade", "from": 116, "to": 117.75, "values": [0, 0.7] },
    { "move": "set", "lane": "fade", "at": 118, "value": 0 },

    { "section": "Climax · a colour per cut", "at": 118 },
    { "at": 118, "note": "Every new clip arrives in a new colour cast, as in Drop III, cut twice as fast from bar 120.", "do": [
      { "effect": { "bus": "A" } }, { "buses": [1, 2] }, { "avSynchro": ["nega"] },
      { "command": { "type": "SET_GRADATION", "on": false } }
    ], "play": { "dance": { "rate": 1 }, "ride": { "rate": 1 }, "tunnel": { "rate": 1 } } },
    { "move": "set", "lane": "avLevel", "at": 118, "value": 0.6 },
    { "move": "set", "lane": "chromaA", "at": 118, "value": 0.9 },
    { "move": "montage", "input": 1, "from": 118, "to": 120, "every": 1,
      "clips": ["dance", "ride", "wheel", "tunnel", "dance", "ride", "rings", "wheel"] },
    { "move": "steps", "lane": "hueA", "from": 118, "every": 1, "values": [0, 0.5, 0.25, 0.75, 0.1, 0.6, 0.35, 0.85] },
    { "at": 119, "do": [{ "fade": { "target": "white", "video": true, "dsk": false } }] },
    { "move": "flash", "at": 120 },
    { "at": 120, "do": [{ "effect": { "bus": "A", "multi": 4 } }] },
    { "move": "montage", "input": 1, "from": 120, "to": 124, "every": 0.5,
      "clips": ["dance", "ride", "dance", "wheel", "ride", "tunnel", "dance", "rings", "ride", "columns", "dance", "wheel", "ride", "shapes", "dance", "streaks"] },
    { "move": "steps", "lane": "hueA", "from": 120, "every": 0.5,
      "values": [0, 0.5, 0.17, 0.67, 0.33, 0.83, 0.08, 0.58, 0.25, 0.75, 0.42, 0.92, 0, 0.5, 0.17, 0.67,
                 0.33, 0.83, 0.08, 0.58, 0.25, 0.75, 0.42, 0.92, 0, 0.5, 0.17, 0.67, 0.33, 0.83, 0.08, 0.58] },
    { "at": 122, "do": [{ "effect": { "bus": "A", "multi": 16 } }] },

    { "section": "Out · light on black", "at": 124 },
    { "at": 124, "note": "The light-on-black look closes the song: the rings as a silhouette, fading out of the window.", "do": [
      { "avSynchro": [] }, { "effect": { "bus": "A" } }, { "fade": { "target": "black", "video": true, "dsk": false } },
      { "matte": "magenta" }, { "command": { "type": "SET_GRADATION", "on": true } },
      { "dsk": { "fill": "matte", "reverse": true, "edge": "wide-shadow" } }
    ], "patch": { "1": "wheel", "ext": "rings" }, "play": { "wheel": { "rate": 0.5 }, "rings": { "from": 0, "rate": 0.5 } } },
    { "move": "set", "lane": "dskHigh", "at": 124, "value": 0.3 },
    { "move": "ramp", "lane": "fade", "from": 124, "to": 125, "values": [0, 1], "curve": "ease" },
    { "at": 125, "do": [{ "matte": "blue" }] },
    { "at": 126, "do": [{ "matte": "cyan" }] },
    { "move": "ramp", "lane": "dskHigh", "from": 125.5, "to": 127, "values": [0.3, 1], "curve": "ease" }
  ]
}
